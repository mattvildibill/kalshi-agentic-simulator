# Copy to .env.local for local development only. Never commit actual secrets.
# Local mode uses .local/portfolio.json and is refused in production/Vercel.
STORAGE_MODE=local
# Generate your own random 32+ character secret. No default credential exists.
BLUE_API_KEY=
# For production, use a NEW dedicated Supabase Free project and apply supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Used by the CLI only. Set to the deployed site for Blue's remote calls.
BLUE_BASE_URL=http://localhost:3000
